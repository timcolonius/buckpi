Cell[CellGroupData[{

Cell["Surface gravity waves", "Section",
 CellChangeTimes->{{3.937411210539415*^9, 3.937411212891225*^9}, 
   3.937412248250002*^9, {3.937412962266694*^9, 
   3.9374129691588373`*^9}},ExpressionUUID->"4b38e6e3-8021-43e7-ae79-\
7381177d47ce"],

Cell["\<\
We hypothesize that the phase speed of a surface gravity wave (riding on a \
constant depth of liquid under a much less dense gaseous atmosphere) is a \
function of its wavelength, the depth of liquid, the acceleration due to \
gravity, the density of the liquid, and the surface tension of the liquid-gas \
interface.\
\>", "Text",
 CellChangeTimes->{{3.93741297597231*^9, 
  3.93741309054327*^9}},ExpressionUUID->"98c11eeb-0cc6-45ac-b677-\
d68876fe297c"],

Cell[BoxData[
 RowBox[{
  RowBox[{"sgw", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       SubscriptBox["c", "p"], ",", 
       RowBox[{"\"\<Meters\>\"", "/", "\"\<Seconds\>\""}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"\[Lambda]", ",", "\"\<Meters\>\""}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"g", ",", 
       RowBox[{"\"\<Meters\>\"", "/", 
        RowBox[{"\"\<Seconds\>\"", "^", "2"}]}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"h", ",", "\"\<Meters\>\""}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"\[Rho]", ",", 
       RowBox[{"\"\<Kilograms\>\"", "/", 
        RowBox[{"\"\<Meters\>\"", "^", "3"}]}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"\[Sigma]", ",", 
       RowBox[{"\"\<Newtons\>\"", "/", "\"\<Meters\>\""}]}], "}"}]}], "}"}]}],
   ";"}]], "Input",
 CellChangeTimes->{{3.9374129578233852`*^9, 3.9374129580364943`*^9}},
 CellLabel->"In[12]:=",ExpressionUUID->"ba073084-a4fe-4b45-b2d2-77593a1fd7d1"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"BuckPi", "[", "sgw", "]"}]], "Input",
 CellChangeTimes->{{3.9374131083114758`*^9, 3.937413109102785*^9}, {
  3.937413206671175*^9, 3.937413208659485*^9}},
 CellLabel->"In[13]:=",ExpressionUUID->"e4f2f1f2-f80f-4071-a64d-efabd85edf33"],

Cell[BoxData[
 TagBox[
  TagBox[GridBox[{
     {
      StyleBox["\[Null]",
       ShowStringCharacters->False], 
      TagBox[
       RowBox[{"\[CapitalPi]", "[", "1", "]"}],
       HoldForm], 
      TagBox[
       RowBox[{"\[CapitalPi]", "[", "2", "]"}],
       HoldForm], 
      TagBox[
       RowBox[{"\[CapitalPi]", "[", "3", "]"}],
       HoldForm]},
     {
      TagBox["1",
       HoldForm], 
      FractionBox[
       RowBox[{
        SqrtBox["h"], " ", 
        SqrtBox["\[Rho]"], " ", 
        SubscriptBox["c", "p"]}], 
       SqrtBox["\[Sigma]"]], 
      FractionBox["\[Lambda]", "h"], 
      FractionBox[
       RowBox[{"g", " ", 
        SuperscriptBox["h", "2"], " ", "\[Rho]"}], "\[Sigma]"]},
     {
      TagBox["2",
       HoldForm], 
      FractionBox[
       RowBox[{
        SuperscriptBox["\[Rho]", 
         RowBox[{"1", "/", "4"}]], " ", 
        SubscriptBox["c", "p"]}], 
       RowBox[{
        SuperscriptBox["g", 
         RowBox[{"1", "/", "4"}]], " ", 
        SuperscriptBox["\[Sigma]", 
         RowBox[{"1", "/", "4"}]]}]], 
      FractionBox[
       RowBox[{
        SqrtBox["g"], " ", "\[Lambda]", " ", 
        SqrtBox["\[Rho]"]}], 
       SqrtBox["\[Sigma]"]], 
      FractionBox[
       RowBox[{
        SqrtBox["g"], " ", "h", " ", 
        SqrtBox["\[Rho]"]}], 
       SqrtBox["\[Sigma]"]]},
     {
      TagBox["3",
       HoldForm], 
      FractionBox[
       SubscriptBox["c", "p"], 
       RowBox[{
        SqrtBox["g"], " ", 
        SqrtBox["h"]}]], 
      FractionBox["\[Lambda]", "h"], 
      FractionBox[
