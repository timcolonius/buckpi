 RowBox[{"vars", " ", "=", " ", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"V", ",", 
      RowBox[{"\"\<Meters\>\"", "^", "3"}]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"R", ",", "\"\<Meters\>\""}], "}"}]}], "}"}]}]], "Input",
