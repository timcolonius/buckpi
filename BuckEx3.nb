Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"BuckPi", "[", "vars", "]"}]], "Input",
 CellChangeTimes->{{3.9374119938484173`*^9, 3.937411995937402*^9}},
 CellLabel->"In[4]:=",ExpressionUUID->"861c90eb-1484-47e6-a4d7-8849dd037ced"],

Cell[BoxData[
 TagBox[
  TagBox[GridBox[{
     {
      StyleBox["\[Null]",
       ShowStringCharacters->False], 
      TagBox[
       RowBox[{"\[CapitalPi]", "[", "1", "]"}],
       HoldForm]},
     {
      TagBox["1",
       HoldForm], 
      FractionBox["V", 
       SuperscriptBox["R", "3"]]},
     {
      TagBox["2",
       HoldForm], 
      FractionBox["R", 
       SuperscriptBox["V", 
        RowBox[{"1", "/", "3"}]]]}
    },
    GridBoxAlignment->{"Columns" -> {{Left}}, "Rows" -> {{Baseline}}},
    GridBoxDividers->{
     "Columns" -> {False, True, {False}, False}, 
      "Rows" -> {False, True, {False}, False}},
    GridBoxSpacings->{"Columns" -> {
        Offset[0.27999999999999997`], {
         Offset[2.0999999999999996`]}, 
        Offset[0.27999999999999997`]}, "Rows" -> {
        Offset[0.2], {
         Offset[0.4]}, 
        Offset[0.2]}}],
   {OutputFormsDump`HeadedRows, OutputFormsDump`HeadedColumns}],
  Function[BoxForm`e$, 
   TableForm[BoxForm`e$, TableHeadings -> {{1, 2}, {
       $CellContext`\[CapitalPi][1]}}]]]], "Output",
 CellChangeTimes->{3.9374119963247747`*^9, 3.93741203508745*^9, 
