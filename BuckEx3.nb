Cell["\<\
We see there are 14 versions of the Pi groups that involve one (ore more) \
variables to the first power.  However, the Binomial function for choosing 3 \
variables from 6 is equal to 20.  Thus there are 6 \
\[OpenCurlyDoubleQuote]forbidden\[CloseCurlyDoubleQuote] choices of 3 \
variables.  Here is one of them\
\>", "Text",
 CellChangeTimes->{{3.93741297597231*^9, 3.93741309054327*^9}, {
  3.9374132216755543`*^9, 
  3.937413322896276*^9}},ExpressionUUID->"f86425d6-4ceb-480a-ad6f-\
35d85a37f969"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"BuckPi", "[", 
  RowBox[{"sgw", ",", 
   RowBox[{"{", 
    RowBox[{"1", ",", "5", ",", "6"}], "}"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.937413334962961*^9, 3.93741334730224*^9}},
 CellLabel->"In[14]:=",ExpressionUUID->"b7230eb1-8bce-407c-aaa7-b37782d035aa"],

Cell[BoxData[
 TagBox[
  RowBox[{"{", "}"}],
  Function[BoxForm`e$, 
   TableForm[BoxForm`e$, TableHeadings -> {{}, {
       $CellContext`\[CapitalPi][1], 
       $CellContext`\[CapitalPi][2], 
       $CellContext`\[CapitalPi][3]}}]]]], "Output",
 CellChangeTimes->{3.937413347771516*^9, 3.937414735903578*^9},
 CellLabel->
  "Out[14]//TableForm=",ExpressionUUID->"32473ef1-d13d-4cb5-86b4-\
0c3392028011"]
}, Open  ]],

Cell["\<\
The problem is that only variables 5 and 6 involve mass units, so they must \
always appear together in the same Pi group -- we cannot isolate them raised \
to the first power in two different Pi groups.\
\>", "Text",
 CellChangeTimes->{{3.93741297597231*^9, 3.93741309054327*^9}, {
  3.9374132216755543`*^9, 3.937413322896276*^9}, {3.9374133578745728`*^9, 
  3.937413421233295*^9}, {3.9374135071169357`*^9, 
  3.937413518043481*^9}},ExpressionUUID->"308cd324-495e-4f2f-a9be-\
502c5ae65bf9"],

Cell["\<\
One of the most important features of dimensional analysis is that it can \
rule out functional dependencies that cannot be expressed in a dimensionless \
form (as nature insists they must).  For example, if we suppose that surface \
tension is not important, such that we eliminate it from our hypothesis:\
\>", "Text",
 CellChangeTimes->{{3.93741297597231*^9, 3.93741309054327*^9}, {
  3.9374132216755543`*^9, 3.937413322896276*^9}, {3.9374133578745728`*^9, 
  3.937413421233295*^9}, {3.9374135071169357`*^9, 3.937413518043481*^9}, {
  3.937413548879903*^9, 
  3.9374136615851297`*^9}},ExpressionUUID->"fc78e95c-62dc-4f4e-ae41-\
93cd81087b3f"],

Cell[BoxData[
 RowBox[{
  RowBox[{"sgw", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       SubscriptBox["c", "p"], ",", 
       RowBox[{"\"\<Meters\>\"", "/", "\"\<Seconds\>\""}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"\[Lambda]", ",", "\"\<Meters\>\""}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"g", ",", 
       RowBox[{"\"\<Meters\>\"", "/", 
        RowBox[{"\"\<Seconds\>\"", "^", "2"}]}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"h", ",", "\"\<Meters\>\""}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"\[Rho]", ",", 
       RowBox[{"\"\<Kilograms\>\"", "/", 
        RowBox[{"\"\<Meters\>\"", "^", "3"}]}]}], "}"}]}], "}"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.9374129578233852`*^9, 3.9374129580364943`*^9}, {
  3.937413669301423*^9, 3.937413669597365*^9}},
 CellLabel->"In[15]:=",ExpressionUUID->"8dc7f60e-f33b-4393-a362-73e653c69b1d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"BuckPi", "[", "sgw", "]"}]], "Input",
 CellChangeTimes->{{3.9374131083114758`*^9, 3.937413109102785*^9}, {
  3.937413206671175*^9, 3.937413208659485*^9}},
 CellLabel->"In[16]:=",ExpressionUUID->"ffe636f7-a276-440e-a729-5b3a9c65eeb3"],

