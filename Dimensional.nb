Cell[BoxData[{
 RowBox[{
  RowBox[{"setupBPT", "[", "terms_List", "]"}], ":=", 
  RowBox[{"With", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"ud", "=", 
      RowBox[{"Union", "[", 
       RowBox[{
        RowBox[{"Flatten", "[", 
         RowBox[{
          RowBox[{"UnitDimensions", "/@", "terms"}], ",", "1"}], "]"}], "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", "1"}], "]"}], "]"}], "]"}]}], "}"}], ",", 
    RowBox[{
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"MemberQ", "[", 
        RowBox[{"ud", ",", "_UnitDimensions"}], "]"}], ",", 
       RowBox[{"Throw", "[", "None", "]"}]}], "]"}], ";", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"Length", "@", "terms"}], "-", 
        RowBox[{"Length", "[", "ud", "]"}]}], ",", "ud"}], "}"}]}]}], 
   "]"}]}], "\n", 
 RowBox[{
  RowBox[{"UDToExp", "[", "dimensions_List", "]"}], ":=", 
  RowBox[{"Times", "@@", 
   RowBox[{"(", 
    RowBox[{"dimensions", "/.", " ", 
     RowBox[{
      RowBox[{"List", "[", 
       RowBox[{"d_String", ",", "n_"}], "]"}], ":>", 
      RowBox[{"Power", "[", 
       RowBox[{"d", ",", "n"}], "]"}]}]}], ")"}]}]}], "\n", 
 RowBox[{
  RowBox[{"Nondimensionalize", "[", 
   RowBox[{"expr_", ",", "vars_List"}], "]"}], ":=", 
  RowBox[{"With", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"exp", "=", 
      RowBox[{"expr", "/.", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"Power", "[", 
           RowBox[{"q_Quantity", ",", "n_"}], "]"}], ":>", 
          RowBox[{
           RowBox[{"UDToExp", "[", 
            RowBox[{"UnitDimensions", "[", "q", "]"}], "]"}], "^", "n"}]}], 
         ",", 
         RowBox[{"qu_Quantity", ":>", 
          RowBox[{"UDToExp", "[", 
           RowBox[{"UnitDimensions", "[", "qu", "]"}], "]"}]}]}], "}"}]}]}], 
     "}"}], ",", 
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"res", "=", 
        RowBox[{"Solve", "[", 
         RowBox[{
          RowBox[{"Thread", "[", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"List", "@@", 
                RowBox[{"PowerExpand", "[", "exp", "]"}]}], ")"}], "/.", " ", 
              
              RowBox[{
               RowBox[{"Power", "[", 
                RowBox[{"unit_String", ",", "n_"}], "]"}], ":>", "n"}]}], 
             ")"}], "==", "0"}], "]"}], ",", "vars"}], "]"}]}], "}"}], ",", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Flatten", "[", "res", "]"}], "===", 
         RowBox[{"{", "}"}]}], ",", 
        RowBox[{"Throw", "[", "None", "]"}], ",", 
        RowBox[{"With", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"nondim", "=", 
            RowBox[{"expr", "/.", " ", 
             RowBox[{"q_Quantity", ":>", 
              RowBox[{"QuantityMagnitude", "[", "q", "]"}]}]}]}], "}"}], ",", 
          
          RowBox[{"First", "[", 
           RowBox[{"nondim", "/.", " ", "res"}], "]"}]}], "]"}]}], "]"}]}], 
     "]"}]}], "]"}]}], "\n", 
 RowBox[{
  RowBox[{"Buckingham\[Pi]", "[", 
   RowBox[{"terms_List", ",", 
    RowBox[{"const", ":", 
     RowBox[{"{", "__Integer", "}"}]}]}], "]"}], ":=", 
  RowBox[{"Catch", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"res", "=", 
         RowBox[{"setupBPT", "[", "terms", "]"}]}], "}"}], ",", 
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Length", "[", 
            RowBox[{"Union", "[", "const", "]"}], "]"}], "=!=", 
           RowBox[{"First", "[", "res", "]"}]}], ",", 
          RowBox[{"Throw", "[", "None", "]"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"MemberQ", "[", 
           RowBox[{"const", ",", 
            RowBox[{"x_", "/;", 
             RowBox[{"x", ">", 
              RowBox[{"Length", "[", "terms", "]"}]}]}]}], "]"}], ",", 
          RowBox[{"Throw", "[", "None", "]"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"With", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"c", "=", "#"}], "}"}], ",", 
          RowBox[{"Module", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"temp", ",", 
              RowBox[{"vars", "=", 
               RowBox[{"{", "}"}]}]}], "}"}], ",", 
            RowBox[{
             RowBox[{"Check", "[", 
              RowBox[{
               RowBox[{"temp", "=", 
                RowBox[{
                 RowBox[{
                  RowBox[{"If", "[", 
                   RowBox[{
                    RowBox[{"Not", "[", 
                    RowBox[{"MemberQ", "[", 
                    RowBox[{"const", ",", "#"}], "]"}], "]"}], ",", 
                    RowBox[{"With", "[", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{"u", "=", 
                    RowBox[{"Unique", "[", "]"}]}], "}"}], ",", 
                    RowBox[{
                    RowBox[{"AppendTo", "[", 
                    RowBox[{"vars", ",", "u"}], "]"}], ";", 
                    RowBox[{
                    RowBox[{"terms", "[", 
                    RowBox[{"[", "#", "]"}], "]"}], "^", "u"}]}]}], "]"}], 
                    ",", 
                    RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{"c", "=!=", "#"}], ",", "1", ",", 
                    RowBox[{"terms", "[", 
                    RowBox[{"[", "#", "]"}], "]"}]}], "]"}]}], "]"}], "&"}], "/@", 
                 RowBox[{"Range", "[", 
                  RowBox[{"Length", "[", "terms", "]"}], "]"}]}]}], ",", 
               RowBox[{"Throw", "[", "None", "]"}], ",", 
               RowBox[{"{", 
                RowBox[{"Part", "::", "partw"}], "}"}]}], "]"}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"Nondimensionalize", "[", 
              RowBox[{
               RowBox[{"Times", "@@", "temp"}], ",", "vars"}], "]"}]}]}], 
           "]"}]}], "]"}]}]}], "]"}], "&"}], "/@", "const"}], 
   "]"}]}]}], "Input",
